{
  "headers": [
    {
      "source": "/chemato.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/chemicals/:slug", "destination": "/all-products.html?categorySlug=:slug" },
    { "source": "/blog/:slug", "destination": "/blog-post.html?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
